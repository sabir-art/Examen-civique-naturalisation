node_modules/
.DS_Store
*.log

# Rien qui puisse contenir une clé ne doit être suivi par Git : le site est
# public. La clé de l'assistant se saisit dans l'application, pas dans un
# fichier (voir js/ai.js et scripts/check-secrets.mjs).
.env
.env.*
*.key
*.pem
secrets.json

# La skill ui-ux-pro-max est un outil de développement (1,9 Mo de données de
# référence) : elle n'a pas à être publiée avec le site.
.claude/skills/

# Captures produites par les contrôles Playwright : elles se régénèrent d'un
# `node scripts/tests/*.mjs`, et versionner des images d'écran ferait grossir
# le dépôt sans rien apporter à la relecture.
scripts/tests/captures/

# Coque native : engendrés par Capacitor, jamais versionnés.
/ios/
/android/
/node_modules/
